# VoxLab root environment — copy to .env and adjust.
# Used by docker-compose and as a reference for backend/.env

# --- Core ---
SECRET_KEY=change-me-in-production
# Fernet key for encrypting stored agent credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database (default: SQLite, no install needed) ---
# Default when unset: sqlite+aiosqlite:///./voxlab.db
DATABASE_URL=
# With Docker Compose:
# DATABASE_URL=postgresql+asyncpg://voxlab:voxlab@localhost:5432/voxlab

# --- Redis (optional; in-process workers used when unset) ---
REDIS_URL=

# --- LLM (any OpenAI-compatible provider, e.g. Groq) ---
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- Security & Networking ---
# Allow agents registered with localhost endpoints (needed for local demo agents; set false in multi-tenant cloud)
ALLOW_LOCAL_ENDPOINTS=true
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Gnani AI Provider Integration (Prisma STT + Timbre TTS) ---
# Set GNANI_ENABLED=true and provide X-API-Key-ID from https://docs.gnani.ai/
GNANI_ENABLED=false
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
